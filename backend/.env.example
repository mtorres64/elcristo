# Generá con: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=tienda_db

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ENVIRONMENT=development
PLATFORM_DOMAIN=tienda.com
UPLOAD_DIR=./uploads

# CORS (lista separada por comas)
# CORS_ORIGINS=http://localhost:5173

# MercadoPago (Fase 2)
MERCADOPAGO_ACCESS_TOKEN=

# Almacenamiento de imágenes en producción (Cloudinary).
# Con ENVIRONMENT=development se ignora y siempre se usa disco local (UPLOAD_DIR).
# Credenciales en cloudinary.com → Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (Fase 2)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
