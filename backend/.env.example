# Generá con: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=tienda_db

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ENVIRONMENT=development
PLATFORM_DOMAIN=tienda.com
UPLOAD_DIR=./uploads

# URL pública del frontend — usada para armar los links de los emails
# (confirmación de cuenta, etc.)
FRONTEND_URL=http://localhost:5173

# CORS (lista separada por comas)
# CORS_ORIGINS=http://localhost:5173

# MercadoPago (Fase 2)
MERCADOPAGO_ACCESS_TOKEN=

# Getnet — la config operativa (credenciales, ambiente, on/off) vive en Mongo
# por tenant (colección tenant_integrations, panel Integraciones). Esta es la
# única pieza de infraestructura que queda en env var: la clave simétrica
# para cifrar/descifrar el client_secret en reposo.
# Generá con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_ENCRYPTION_KEY=

# Almacenamiento de imágenes en producción (Cloudinary).
# Con ENVIRONMENT=development se ignora y siempre se usa disco local (UPLOAD_DIR).
# Credenciales en cloudinary.com → Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP — envío de emails transaccionales (confirmación de cuenta).
# Fallback global: el panel de Integraciones → Correo (config por tenant en
# Mongo) tiene prioridad sobre estas variables. Si no hay ni una ni otra, el
# email NO se envía: el contenido (con el link) se escribe en el log del backend.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Vivero El Cristo <no-reply@tienda.com>
